{
  // -------------------------------------------------------------------------
  // TEMPLATE FILE — safe to commit. Contains NO real secret values.
  //
  // Secret values are supplied OUTSIDE the repo so they are never committed:
  //   * Development: .NET User Secrets (per-machine), e.g.
  //       dotnet user-secrets set "Jwt:Secret" "<64-char-key>" --project AssetTracker.API
  //       dotnet user-secrets set "Email:SmtpPassword" "<gmail-app-password>" --project AssetTracker.API
  //   * Production: environment variables (use "__" as the separator), e.g.
  //       Jwt__Secret, Email__SmtpPassword
  // -------------------------------------------------------------------------
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER\\SQLEXPRESS;Database=AssetTrackerDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY",
    "Issuer": "AssetTrackerAPI",
    "Audience": "AssetTrackerUI"
  },
  "Email": {
    "Provider": "SMTP",
    "SmtpHost": "smtp.example.com",
    "SmtpPort": "587",
    "SmtpUser": "your-smtp-user@example.com",
    "SmtpPassword": "REPLACE_WITH_SMTP_APP_PASSWORD",
    "FromEmail": "your-smtp-user@example.com",
    "FromName": "Asset Tracker System",
    "AdminEmail": "admin@example.com",
    "SendGridApiKey": "REPLACE_ONLY_IF_USING_SENDGRID_PROVIDER"
  }
}
